// mhgcp.config — SLURM executor settings for the BCM mhgcp cluster.
// Loaded by run_scnanoseq.slurm via `-c conf/mhgcp.config`.

executor {
  name      = 'slurm'
  queueSize = 20          // max concurrent SLURM jobs
  submitRateLimit = '10 sec'
}

process {
  executor = 'slurm'
  // Default partition; big-memory steps are routed in mhgcp_resources.config.
  queue    = { task.cpus > 48 || task.memory.toGiga() > 125 ? 'mhgcp' : 'short' }
  // Do NOT run on the head node; Nextflow itself is submitted via sbatch.
  errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
  maxRetries    = 2
}

singularity {
  enabled    = true
  autoMounts = true
  // Cache Singularity images on scratch to avoid home-quota fills.
  cacheDir   = "${System.getenv('SCRATCH') ?: '$PWD'}/singularity_cache"
}

// Nextflow work dir on scratch (large intermediate BAMs).
workDir = "${System.getenv('SCRATCH') ?: '$PWD'}/nf_work"
