// mhgcp_resources.config — PromethION-scale process resources for scnanoseq.
// scnanoseq defaults (process_single 1cpu/6GB) are far too small for a full
// PromethION flow cell; these overrides target the mhgcp 56 CPU / 256 GB nodes.

process {
  // BLAZE barcode detection — CPU-hungry on long reads
  withName: '.*BLAZE' {
    cpus   = 30
    memory = '120.GB'
    time   = '24.h'
    queue  = 'mhgcp'
  }
  // minimap2 alignment
  withName: '.*MINIMAP2.*' {
    cpus   = 20
    memory = '64.GB'
    time   = '24.h'
    queue  = 'mhgcp'
  }
  // Barcode tagging / correction
  withName: '.*TAG_BARCODES.*' {
    cpus   = 8
    memory = '60.GB'
    time   = '12.h'
  }
  // oarfish transcript quantification — much lighter than IsoQuant
  withName: '.*OARFISH.*' {
    cpus   = 8
    memory = '16.GB'
    time   = '4.h'
    queue  = 'mhgcp'
  }
  // UMI-tools dedup
  withName: '.*UMI.*' {
    cpus   = 8
    memory = '48.GB'
    time   = '12.h'
  }
}
